+    def _provenance_case(self, body, *, helper="", class_tail="", module_tail=""):
+        process = (
+            'subprocess.run([sys.executable, "-m", module], cwd=".", '
+            'env={**__import__("os").environ, "SAFE": "1"}, '
+            'timeout=5, check=False)'
