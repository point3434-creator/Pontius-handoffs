+@dataclass(frozen=True, slots=True)
+class VerifiedTrace:
+    """A legal, timely trace; no claim about host publication or source sealing."""
+
+    run_id: str
+    semantic_sha256: str
+    payouts: tuple[int, ...]
+    final_stacks: tuple[int, ...]
+    pots: tuple[tuple[int, tuple[int, ...]], ...]
