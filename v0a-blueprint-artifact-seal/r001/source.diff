+                            with self.assertRaises((TypeError, generator.InventoryError)):
+                                acquire()
+                        self.assertFalse(routing.native_is_open(acquired[-1]))
+                    self.assertEqual(len(acquired), 2)
+                finally:
+                    filesystem._windows_close_directory(directory)
