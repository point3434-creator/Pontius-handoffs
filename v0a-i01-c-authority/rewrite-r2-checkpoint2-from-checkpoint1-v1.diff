+def _c_exception_matches(
+    ctx: _CContext, state: _CState, tag: str, selected: _CValue,
+) -> bool | None:
+    ctx.budget.consume()  # Handler type/tuple dispatch.
+    if type(selected) is _CExceptionType:
+        ctx.budget.consume(2)  # Proved tag read and exact type comparison.
+        return selected.tag == tag
+    record = _c_object_read(ctx, state, selected) if type(selected) is _CRef else None
+    if type(record) is not _CSequence:
+        return None
+    ctx.budget.consume()  # Current native-sequence kind check.
+    if record.kind != "tuple":
+        return None
+    matched = False
+    for alternative in record.elements:
+        ctx.budget.consume(2)  # Element visit and proof check, before any tag read.
+        if type(alternative) is not _CExceptionType:
+            return None
+        ctx.budget.consume(2)
+        matched = alternative.tag == tag or matched
+    return matched
