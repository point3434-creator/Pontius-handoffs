+def _name_balance(meter, node):
+    meter.charge("balance_metadata_reads", 2)
+    delta = _name_height(node.left) - _name_height(node.right)
+    meter.charge("balance_comparisons")
+    if delta > 1:
+        left = node.left
+        meter.charge("balance_metadata_reads", 2)
+        meter.charge("balance_comparisons")
+        if _name_height(left.left) < _name_height(left.right):
+            pivot = left.right
+            left = _name_node(meter, pivot.name, pivot.entry,
+                         _name_node(meter, left.name, left.entry, left.left, pivot.left), pivot.right)
+        return _name_node(meter, left.name, left.entry, left.left,
+                     _name_node(meter, node.name, node.entry, left.right, node.right))
+    meter.charge("balance_comparisons")
+    if delta < -1:
+        right = node.right
+        meter.charge("balance_metadata_reads", 2)
+        meter.charge("balance_comparisons")
+        if _name_height(right.right) < _name_height(right.left):
+            pivot = right.left
+            right = _name_node(meter, pivot.name, pivot.entry, pivot.left,
+                          _name_node(meter, right.name, right.entry, pivot.right, right.right))
+        return _name_node(meter, right.name, right.entry,
+                     _name_node(meter, node.name, node.entry, node.left, right.left), right.right)
+    return node
+
