+def _name_set(meter, node, name, entry):
+    meter.charge("set_node_visits")
+    if node is None:
+        return _name_node(meter, name, entry, None, None), True
+    meter.charge("key_comparisons")
+    if name == node.name:
+        return _name_node(meter, node.name, entry, node.left, node.right), False
+    meter.charge("key_comparisons")
+    if name < node.name:
+        left, inserted = _name_set(meter, node.left, name, entry)
+        result = _name_node(meter, node.name, node.entry, left, node.right)
+    else:
+        right, inserted = _name_set(meter, node.right, name, entry)
+        result = _name_node(meter, node.name, node.entry, node.left, right)
+    return _name_balance(meter, result), inserted
+
