+def _name_delete(meter, node, name):
+    meter.charge("delete_node_visits")
+    if node is None:
+        raise KeyError(name)
+    meter.charge("key_comparisons")
+    if name == node.name:
+        if node.left is None:
+            return node.right
+        if node.right is None:
+            return node.left
+        successor = node.right
+        while successor.left is not None:
+            meter.charge("delete_successor_visits")
+            successor = successor.left
+        right = _name_delete(meter, node.right, successor.name)
+        return _name_balance(meter, _name_node(meter, successor.name, successor.entry, node.left, right))
+    meter.charge("key_comparisons")
