+def _name_find(meter, node, name):
+    while node is not None:
+        meter.charge("lookup_node_visits")
+        meter.charge("key_comparisons")
+        if name == node.name:
+            return node.entry
+        meter.charge("key_comparisons")
+        node = node.left if name < node.name else node.right
+    return _NAME_MISSING
+
