+            node.ops[0], (ast.Is, ast.IsNot)):
+        ctx.budget.consume()
+        outcomes = []
+        ctx.budget.consume(3)
+        for prior, values in _c_eval_many(ctx, state, frame, (node.left, node.comparators[0])):
+            ctx.budget.consume()
+            if prior.control == "normal":
+                left, right = values
+                answer = None
+                if isinstance(node.ops[0], (ast.Is, ast.IsNot)):
+                    if type(left) is _CAtom and left.kind == "literal" and left.data is None:
+                        answer = type(right) is _CAtom and right.kind == "literal" and right.data is None
+                        if type(right) is _CAtom and right.kind in {"unknown", "unbound"}:
+                            answer = None
+                    elif type(right) is _CAtom and right.kind == "literal" and right.data is None:
+                        answer = type(left) is _CAtom and left.kind == "literal" and left.data is None
+                        if type(left) is _CAtom and left.kind in {"unknown", "unbound"}:
+                            answer = None
+                    elif type(left) is _CRef and type(right) is _CRef:
+                        answer = left.object_id == right.object_id
+                    if answer is not None and isinstance(node.ops[0], ast.IsNot):
