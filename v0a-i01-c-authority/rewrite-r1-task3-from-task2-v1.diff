+def _c_store(
+    ctx: _CContext, state: _CState, frame: _CFrame, target: ast.expr,
+    value: _CValue | None,
+) -> tuple[_COutcome, ...]:
+    ctx.budget.consume()
+    if isinstance(target, ast.Name):
+        return _c_store_name(ctx, state, frame, target.id, value, target)
+    if isinstance(target, (ast.Tuple, ast.List)) and value is not None:
+        record = _c_object_read(ctx, state, value) if type(value) is _CRef else None
+        if not isinstance(record, _CSequence) or len(record.elements) != len(target.elts):
+            return _c_one(ctx, _c_fail(ctx, state, target, "unsupported unpacking or arity"))
+        # Capture these references once, before any target store.
+        elements = record.elements
+        outcomes = _c_one(ctx, _c_out(ctx, state, value))
+        for index, child in enumerate(target.elts):
+            ctx.budget.consume(2)
+            next_outcomes: list[_COutcome] = []
+            for prior in outcomes:
+                ctx.budget.consume()
+                produced = _c_store(ctx, prior.state, frame, child, elements[index]) if (
+                    prior.control == "normal") else _c_one(ctx, prior)
+                for result in produced:
+                    ctx.budget.consume(2)
+                    next_outcomes.append(_c_follow(ctx, prior, result) if (
+                        prior.control == "normal") else result)
+            outcomes = _c_join(ctx, next_outcomes)
+        ctx.budget.consume()
+        restored: list[_COutcome] = []
+        for result in outcomes:
+            ctx.budget.consume(2)
+            restored.append(_c_out(ctx, result.state, value, issues=result.issues,
+                                    trace=result.trace) if result.control == "normal" else result)
+        return _c_join(ctx, restored)
+    if isinstance(target, ast.Attribute):
+        ctx.budget.consume()
+        outcomes: list[_COutcome] = []
+        for prior in _c_eval(ctx, state, frame, target.value):
+            ctx.budget.consume()
+            result = prior
+            if prior.control == "normal":
+                record = _c_object_read(ctx, prior.state, prior.result) if (
+                    type(prior.result) is _CRef) else None
+                if isinstance(record, _CNamespace) and record.kind == "class":
+                    _c_namespace_write(ctx, prior.state, prior.result, target.attr, value)
+                    result = _c_follow(ctx, prior, _c_fail(
+                        ctx, prior.state, target, "reached protected class namespace write"))
+                else:
+                    result = _c_follow(ctx, prior, _c_fail(
+                        ctx, prior.state, target, "unsupported attribute write"))
+            ctx.budget.consume(2)
+            outcomes.append(result)
+        return _c_join(ctx, outcomes)
+    return _c_one(ctx, _c_fail(ctx, state, target, "unsupported canonical assignment target"))
+
