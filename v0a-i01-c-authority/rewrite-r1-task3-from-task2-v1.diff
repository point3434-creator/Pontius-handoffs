+def _c_out(
+    ctx: _CContext, state: _CState, value: _CValue | None = None, *,
+    control: str = "normal", exception: str | None = None,
+    issues: tuple[_CIssue, ...] = (), trace: _CTrace | None = None,
+) -> _COutcome:
+    if value is None:
+        value = _c_atom(ctx, "literal")
+    if trace is None:
+        trace = _c_trace(ctx, "empty", ())
+    ctx.budget.consume(10)  # Outcome, eight fields and empty exclusion set.
+    return _COutcome(state, value, control, exception, False, frozenset(), issues, trace)
+
