+    if value is None or (type(value) is _CAtom and value.kind == "unbound"):
+        return _c_one(ctx, _c_fail(ctx, state, site, "unresolved or unbound name: " + name,
+                                  exception="NameError"))
+    return _c_one(ctx, _c_out(ctx, state, value))
