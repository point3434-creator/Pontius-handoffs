+def _c_fail(
+    ctx: _CContext, state: _CState, site: ast.AST, reason: str, *,
+    exception: str | None = None,
+) -> _COutcome:
+    ctx.budget.consume(7)  # Issue and four fields; singleton tuple and reference.
+    issue = _CIssue(site, ctx.path, reason, "unsupported" if exception is None else "exception")
+    trace = _c_trace(ctx, "event", (), issue)
+    return _c_out(ctx, state, control="refused" if exception is None else "raise",
+                  exception=exception, issues=(issue,), trace=trace)
+
