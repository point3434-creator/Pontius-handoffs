+def _c_eval_dict(
+    ctx: _CContext, state: _CState, frame: _CFrame, node: ast.Dict,
+) -> tuple[_COutcome, ...]:
+    ctx.budget.consume()
+    expressions: list[ast.expr] = []
+    for key, value in zip(node.keys, node.values, strict=True):
+        ctx.budget.consume()
+        if key is not None:
+            ctx.budget.consume(2)
+            expressions.append(key)
+        ctx.budget.consume(2)
+        expressions.append(value)
+    ctx.budget.consume()
+    outcomes: list[_COutcome] = []
+    for prior, values in _c_eval_many(ctx, state, frame, expressions):
+        ctx.budget.consume()
+        if prior.control != "normal":
+            ctx.budget.consume(2)
+            outcomes.append(prior)
+            continue
+        ctx.budget.consume()
+        additions: dict[str, str] = {}
+        inherited, reason, index = False, None, 0
+        for key in node.keys:
+            ctx.budget.consume()
+            if key is None:
+                source = values[index]
+                index += 1
+                record = _c_object_read(ctx, prior.state, source) if type(source) is _CRef else None
+                if not isinstance(record, _CEnvironment) or record.removals or record.unresolved_reason:
+                    reason = "unsupported environment mapping expansion"
+                    break
+                inherited = inherited or record.inherited
+                for name, value in record.additions:
+                    ctx.budget.consume(4)
+                    additions[name] = value
+            else:
+                key_value, value = values[index], values[index + 1]
+                index += 2
+                if not (type(key_value) is _CAtom and key_value.kind == "literal"
+                        and type(key_value.data) is str and type(value) is _CAtom
+                        and value.kind == "literal" and type(value.data) is str):
+                    reason = "environment keys and values must be exact strings"
+                    break
+                ctx.budget.consume(3)
+                additions[key_value.data] = value.data
+        if reason:
+            result = _c_fail(ctx, prior.state, node, reason)
+        else:
+            ctx.budget.consume(1 + 5 * len(additions))  # Ordered items tuple and pair refs.
+            items = tuple(additions.items())
+            ctx.budget.consume(5)
+            result = _c_out(ctx, prior.state, _c_new_object(
+                ctx, prior.state, _CEnvironment(inherited, items, (), None)))
+        ctx.budget.consume(2)
+        outcomes.append(_c_follow(ctx, prior, result))
+    return _c_join(ctx, outcomes)
