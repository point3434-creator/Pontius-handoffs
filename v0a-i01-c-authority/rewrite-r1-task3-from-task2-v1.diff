+def _c_truth(ctx: _CContext, value: _CValue) -> bool | None:
+    ctx.budget.consume()
+    if type(value) is _CAtom and value.kind == "literal":
+        data = value.data
+        if data is None or type(data) is str or type(data) is int or (
+                type(data) is float or type(data) is bool):
+            return bool(data)
+    return None
