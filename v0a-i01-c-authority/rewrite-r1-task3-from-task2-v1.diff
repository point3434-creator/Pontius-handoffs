+def _c_store_name(
+    ctx: _CContext, state: _CState, frame: _CFrame, name: str,
+    value: _CValue | None, site: ast.AST,
+) -> tuple[_COutcome, ...]:
+    route = _c_name_route(ctx, state, frame, name, writing=True)
+    if route.kind == "cell":
+        installed = value if value is not None else _c_atom(ctx, "unbound")
+        if _c_cell_write(ctx, state, route.cell, installed):
+            return _c_one(ctx, _c_out(ctx, state, installed))
+    elif route.kind in {"module", "class"}:
+        if route.kind == "module" and frame.scope.kind != "module":
+            return _c_one(ctx, _c_fail(ctx, state, site, "unsupported declared module write"))
+        _c_namespace_write(ctx, state, route.module, name, value)
+        return _c_one(ctx, _c_out(ctx, state, value))
+    return _c_one(ctx, _c_fail(ctx, state, site, "unproved lexical write destination"))
