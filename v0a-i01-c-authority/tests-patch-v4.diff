+    def test_authority_transfer_capture_route_execution_matrix(self) -> None:
+        routes = (
+            ("direct", "", "callback()"),
+            ("alias", "saved = callback", "saved()"),
+            ("forward", "def forward(target):\n    target()", "forward(callback)"),
+            ("return", "def forward(target):\n    return target\nsaved = forward(callback)",
+             "saved()"),
+            ("returned-nest", 'def forward(target):\n    return {"cb": (target,)}\n'
+             'saved = forward(callback)["cb"][0]', "saved()"),
+            ("flat-store", "bag = []\nbag.append(callback)", "bag[0]()"),
+            ("nested-store", 'bag = {"inner": [[]]}\nbag["inner"][0].append(callback)',
+             'bag["inner"][0][0]()'),
+            ("protocol", "class Value:\n    def __call__(self):\n        callback()",
+             "Value()()"),
+        )
+        cases = []
+        for capture in ("default", "cell"):
+            for route, setup, invocation in routes:
+                for mode in ("dormant", "readonly", "write", "raise-before"):
+                    body = self._callback(capture, mode) + "\n" + setup
+                    trace = ("sink",)
+                    dead = ("body", "write")
+                    if mode == "raise-before":
+                        body += "\ntry:\n    " + invocation
+                        body += "\nexcept ValueError:\n    # oracle caught\n    pass"
+                        trace, dead = ("body", "caught", "sink"), ("write",)
+                    elif mode != "dormant":
+                        body += "\n" + invocation
+                        trace = ("body", "write") if mode == "write" else ("body", "sink")
+                        dead = () if mode == "write" else ("write",)
+                    cases.append(self._schedule(
+                        "/".join((capture, route, mode)), body, trace=trace,
+                        result="TypeError" if mode == "write" else "fixed",
+                        classification=(
+                            "permitted-refusal"
+                            if route in {"return", "returned-nest", "flat-store"}
+                            and mode in {"readonly", "raise-before"}
+                            else "refuse" if mode == "write" else "clean"
+                        ),
+                        unreachable=dead,
+                    ))
+        self._exercise("capture-route-execution", cases, 64)
