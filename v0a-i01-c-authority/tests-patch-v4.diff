+                + "\n" + store + "\n" + invocation,
+                trace=("body", "write"), result="TypeError", classification="refuse",
+                module_tail="def external(callback):\n    callback(None)\n",
+            ))
+        self._exercise("issued-witnesses", cases, 16)
