+                "def callback():\n    # oracle body\n"
+                "    if owner is not None:\n        owner._launch = None\n"
+                "        # oracle write\n"
+                "def forward(callback):\n    return " + expression + "\n"
+                "saved = forward(callback)\nowner = ReviewTests\nsaved()"
+            )
+            cases.append(self._schedule(
+                "A01/" + expression, body, trace=("body", "write"),
+                result="TypeError", classification="refuse",
+            ))
+        for extraction in ('bag.pop("cb")', 'bag.get("cb")', "bag.popitem()[1]"):
+            body = (self._callback("default", "write") + '\nbag = {"cb": callback}\n'
+                    "saved = " + extraction + "\nsaved()")
+            cases.append(self._schedule(
+                "A02/" + extraction, body, trace=("body", "write"),
+                result="TypeError", classification="refuse",
+            ))
+        for kind in ("captured", "called", "decorator"):
+            member = (
+                "    def callback(function=None):\n        # oracle body\n"
+                "        ReviewTests._launch = None\n        # oracle write\n"
+                "        return function\n"
+            )
+            if kind == "captured":
+                use = ("    def __call__(self, target=callback):\n        target()\nValue()()")
+            elif kind == "called":
+                use = "    def method(self, value=callback()):\n        return 1"
+            else:
+                use = "    @callback\n    def method(self):\n        return 1"
+            cases.append(self._schedule(
+                "A03/" + kind, "class Value:\n" + member + use,
+                trace=("body", "write"), result="TypeError", classification="refuse",
+            ))
+        retained = (
+            ("nested-list", "bag = [[]]\nbag[0].append(callback)", "bag[0][0]", False),
+            ("mapping-list", 'bag = {"x": []}\nbag["x"].append(callback)',
+             'bag["x"][0]', False),
+            ("tuple-list", "bag = ([],)\nbag[0].append(callback)", "bag[0][0]", False),
+            ("older-alias", "items = []\nbag = [items]\nbag[0].append(callback)",
+             "bag[0][0]", False),
+            ("extend", "bag = [[]]\nbag[0].extend([callback])", "bag[0][0]", False),
+            ("insert", "bag = [[]]\nbag[0].insert(0, callback)", "bag[0][0]", False),
+            ("direct", "bag = [[]]\nbag[0].append(callback)", "bag[0][0]", True),
+        )
+        for label, store, extraction, direct in retained:
+            invocation = extraction + "(None)" if direct else "external(" + extraction + ")"
+            cases.append(self._schedule(
