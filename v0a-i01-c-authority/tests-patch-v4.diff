+class AuthorityTransferMatrixTests(unittest.TestCase):
+    """Bounded public contracts, with separately rendered harmless Python oracles."""
+
+    @staticmethod
+    def _schedule(
+        label: str,
+        body: str,
+        *,
+        trace: tuple[str, ...],
+        result: str = "fixed",
+        classification: str = "clean",
+        tail: str = "return self._launch()",
+        module_tail: str = "",
+        unreachable: tuple[str, ...] = (),
+        choices: tuple[tuple[bool, tuple[str, ...], str], ...] = (),
+        required_argv: tuple[tuple[str, ...], ...] | None = None,
+    ) -> dict[str, object]:
+        return {
+            "label": label, "body": body, "trace": trace, "result": result,
+            "classification": classification, "tail": tail,
+            "module_tail": module_tail, "unreachable": unreachable, "choices": choices,
+            "required_argv": required_argv,
+        }
+
+    @staticmethod
+    def _callback(capture: str, mode: str, *, ignored: bool = False) -> str:
+        prefix = "owner = ReviewTests\n" if capture == "cell" else ""
+        parameters = "_=None" if ignored else ""
+        if capture == "default":
+            parameters += (", " if parameters else "") + "owner=ReviewTests"
+        body = "# oracle body\n"
+        if mode == "raise-before":
+            body += "raise ValueError()\n"
+        if mode in {"write", "dormant", "raise-before", "write-then-raise"}:
+            body += "owner._launch = None\n# oracle write\n"
+        else:
+            body += "unused = owner\n"
+        if mode == "write-then-raise":
+            body += "raise ValueError()\n"
+        body += "return 1"
+        return prefix + "def callback(" + parameters + "):\n" + textwrap.indent(body, "    ")
+
+    @staticmethod
+    def _program(schedule: dict[str, object], *, harmless: bool) -> str:
+        # Assemble the safe sink independently. Never transform an executable sink.
+        if harmless:
+            head = "import unittest\n_events = []\n"
+            launch = '_events.append("sink")\nreturn "fixed"'
+        else:
+            head = "import subprocess, sys, unittest\n"
+            launch = (
+                'subprocess.run([sys.executable, "-m", "fixed"], cwd=".", '
+                'env={**__import__("os").environ, "SAFE": "1"}, timeout=5, check=False)'
+            )
+        body = str(schedule["body"]) + "\n" + str(schedule["tail"])
+        program = (
+            head + "class ReviewTests(unittest.TestCase):\n"
+            "    @staticmethod\n    def _launch(ignored=None):\n"
+            + textwrap.indent(launch, "        ")
+            + "\n    def test_static(self):\n" + textwrap.indent(body, "        ")
+            + "\n" + str(schedule["module_tail"]) + "\n"
+        )
+        if harmless:
+            observed = []
+            for line in program.splitlines():
+                stripped = line.lstrip()
+                if stripped.startswith("# oracle "):
+                    event = stripped.removeprefix("# oracle ")
+                    indent = line[:len(line) - len(stripped)]
+                    line = indent + "_events.append(" + repr(event) + ")"
+                observed.append(line)
+            program = "\n".join(observed) + "\n"
+        return program
+
+    def _exercise(self, family: str, cases: list[dict[str, object]], planned: int) -> None:
+        self.assertEqual(len(cases), planned, "matrix generation must not silently omit cases")
+        labels = [str(case["label"]) for case in cases]
+        self.assertEqual(len(labels), len(set(labels)), "matrix case identifiers must be unique")
+        generator = _load_generator()
+        stable_id = "tests/test_review.py::ReviewTests::test_static"
+        assignment = {
+            "profile_name": "current", "payload_id": "current:tests/test_review.py",
+            "expectation": {"kind": "pass"},
+        }
+        census = {
+            "test_file_count": 1, "stable_id_count": 1,
+            "stable_ids_sha256": sha256((stable_id + "\n").encode()).hexdigest(),
+        }
+        inventory = {
+            "schema_version": "pontius-test-inventory-v1", "baseline_commit": "1" * 40,
+            "baseline_discovery": census, "discovery": census,
+            "entries": [{
+                "stable_id": stable_id, "relative_path": "tests/test_review.py",
+                "case_name": "ReviewTests", "method_name": "test_static",
+                "assignment": assignment, "baseline_assignment": assignment,
+            }],
+        }
+        inventory_bytes = _canonical_json_bytes(inventory) + b"\n"
+        exercised = 0
+        oracle_errors = []
+        analyzer_errors = []
+        unexecuted = []
+        for case in cases:
+            label = str(case["label"])
+            with self.subTest(family=family, schedule=label):
+                source = self._program(case, harmless=False).encode("utf-8")
+                pure = self._program(case, harmless=True)
+                self.assertNotIn("subprocess", pure)
+                self.assertNotIn("pontius", pure)
+                witnesses = []
+                variants = case["choices"] or ((False, case["trace"], case["result"]),)
+                for choice, expected_trace, expected_result in variants:
+                    namespace = {}
+                    try:
+                        exec(compile(pure, "<authority-oracle>", "exec", dont_inherit=True),
+                             namespace)
+                        instance = namespace["ReviewTests"]()
+                        instance.choice = choice
+                        try:
+                            actual = instance.test_static()
+                        except Exception as error:
+                            actual = type(error).__name__
+                        events = tuple(namespace["_events"])
+                    except Exception as error:
+                        oracle_errors.append(label)
+                        print(json.dumps({"matrix": family, "case": label,
+                                          "oracle_error": type(error).__name__,
+                                          "message": str(error)}), flush=True)
+                        raise
+                    witnesses.append({"choice": choice, "result": actual, "trace": events})
+                    if actual != expected_result or events != expected_trace:
+                        oracle_errors.append(label)
+                    self.assertEqual(actual, expected_result, "invalid runtime oracle")
+                    self.assertEqual(events, expected_trace, "invalid effect/order oracle")
+                    for event in case["unreachable"]:
+                        self.assertNotIn(event, events, "claimed dead event was executed")
+                try:
+                    review = generator.derive_design_review(
+                        baseline_commit="1" * 40, baseline_root_tree_oid="2" * 40,
+                        inventory_document=inventory, inventory_document_bytes=inventory_bytes,
+                        sources={"tests/test_review.py": source},
+                        item_universe=(("stable_id", stable_id),),
+                    )
+                except Exception as error:
+                    analyzer_errors.append(label)
+                    print(json.dumps({"matrix": family, "case": label,
+                                      "analyzer_error": type(error).__name__,
+                                      "message": str(error)}), flush=True)
+                    raise
+                exercised += 1
+                if case["unreachable"]:
+                    unexecuted.append({"case": label, "events": case["unreachable"]})
+                rows = [row for row in review["receipt"]["expanded_rows"]
+                        if row["capability_kind"] == "subprocess"]
+                blockers = review["unresolved_dynamic_blockers"]
+                argv = [row["argv"] for row in rows]
+                print(json.dumps({
+                    "matrix": family, "case": label, "classification": case["classification"],
+                    "source_sha256": sha256(source).hexdigest(),
+                    "oracle_sha256": sha256(pure.encode()).hexdigest(),
+                    "witnesses": witnesses, "argv": argv, "blockers": blockers,
+                    "unreachable_events": case["unreachable"],
+                }), flush=True)
+                if case["classification"] == "refuse":
+                    self.assertTrue(blockers, "relevant reached/escaped authority needs a blocker")
+                    if case["required_argv"] is not None:
+                        self.assertEqual(argv, [list(row) for row in case["required_argv"]])
+                elif case["classification"] == "permitted-refusal":
+                    if not blockers:
+                        self.assertEqual(argv, [["-m", "fixed"]])
+                else:
+                    self.assertEqual(case["classification"], "clean")
+                    self.assertFalse(blockers, "lawful represented schedule must remain admitted")
+                    self.assertEqual(argv, [["-m", "fixed"]])
+        print(json.dumps({
+            "matrix_summary": family, "planned": planned, "generated": len(cases),
+            "exercised": exercised, "unreachable_cases": [],
+            "proved_unexecuted_events": unexecuted,
+            "oracle_errors": oracle_errors, "analyzer_errors": analyzer_errors,
+        }), flush=True)
