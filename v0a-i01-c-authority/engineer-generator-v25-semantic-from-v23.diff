+    def _class_member_owner_ids(
+        self, owner: _FlowValue, values: Mapping[str, _FlowValue], *,
+        instance_read: bool = False, member_lookup: bool = False,
+    ) -> tuple[tuple[int, ...], bool, tuple[_FlowValue, ...]]:
+        """Find receiver/name-selected base alternatives, never contained/captured classes."""
+        self.budget.consume(6)
+        pending = [("receiver", owner)]
+        seen_values: set[tuple[str, int]] = set()
+        seen_authority: set[tuple[str, int]] = set()
+        identities: list[int] = []
+        issues: list[_FlowValue] = []
+        unresolved = False
+        store = self._authority(values)
+        while pending:
+            role, current = pending.pop()
+            self.budget.consume(2)
+            key = (role, id(current))
+            if key in seen_values:
+                continue
+            seen_values.add(key)
+            if current.callable_definition is not None:
+                continue
+            if current.kind == "implicit_class_instance" and not instance_read:
+                continue
+            if current.kind == "class_member_base":
+                if member_lookup and isinstance(current.value, _FlowValue):
+                    self.budget.consume()
+                    pending.append(("base", current.value))
+                continue
+            if current.helper_refusal is not None or current.kind == "helper_deferred_refusal":
+                self.budget.consume(2)
+                issues.append(_FlowValue("helper_deferred_refusal", reason=(
+                    current.helper_refusal or current.reason
+                    or "helper namespace class owner is unresolved")))
+            explicit_class = bool(current.kind == "implicit_class" or (
+                current.helper_provenance is not None
+                and current.helper_provenance.kind == "class"
+            ))
+            if current.authority_refs:
+                for identity in current.authority_refs:
+                    self.budget.consume()
+                    authority_key = (role, identity)
+                    if authority_key in seen_authority:
+                        continue
+                    seen_authority.add(authority_key)
+                    authority_record = store.objects.get(identity)
+                    if authority_record is None:
+                        unresolved |= explicit_class
+                        self.budget.consume(2)
+                        issues.append(_FlowValue("helper_deferred_refusal",
+                                                reason="helper namespace authority state is unresolved"))
+                    elif authority_record.class_member_owner:
+                        identities.append(identity)
+                        # Current records dominate historical embedded projections.
+                        if member_lookup:
+                            self.budget.consume(len(authority_record.value.helper_obligations))
+                            pending.extend((role, item) for item in authority_record.value.helper_obligations
+                                           if item.kind == "class_member_base")
+                    else:
+                        pending.append((role, authority_record.value))
+                        if not authority_record.value.mutable_collection:
+                            self.budget.consume(len(authority_record.retained))
+                            pending.extend((role, item) for item in authority_record.retained)
