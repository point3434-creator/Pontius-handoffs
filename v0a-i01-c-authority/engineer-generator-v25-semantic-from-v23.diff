+        self.budget.consume(3 + 2 * len(frame.scope.local_names)
+                            + len(frame.scope.global_names) + len(frame.scope.nonlocal_names))
+        local_names = frame.scope.local_names - frame.scope.global_names - frame.scope.nonlocal_names
+        own = []
