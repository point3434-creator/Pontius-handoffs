+                if current.kind != "implicit_class":
+                    self.budget.consume(len(current.helper_obligations))
+                    pending.extend((role, item) for item in current.helper_obligations
+                                   if item.kind == "deferred_result_carrier")
+                continue
+            elif explicit_class:
+                unresolved = True
+                if role == "base":
+                    self.budget.consume(2)
+                    issues.append(_FlowValue("helper_deferred_refusal",
+                                            reason="helper namespace inherited member authority is unresolved"))
+            elif role == "base" and not current.helper_obligations and current.kind not in {
+                "deferred_result_carrier", "maybe_unbound", "implicit_protocol_merged",
+            }:
+                self.budget.consume(2)
+                issues.append(_FlowValue("helper_deferred_refusal",
+                                        reason="helper namespace inherited member authority is unresolved"))
+            if current.kind == "deferred_result_carrier" and isinstance(
+                current.value, _DeferredResultCarrier,
+            ):
+                if current.value.role == "alternative":
+                    self.budget.consume(len(current.value.roots))
+                    pending.extend((role, item) for item in current.value.roots)
+                continue
+            if current.kind in {"maybe_unbound", "implicit_protocol_merged",
+                                "deferred_generator_container_merged"}:
+                self.budget.consume(len(current.value))
+                pending.extend((role, item) for item in current.value if isinstance(item, _FlowValue))
+            self.budget.consume(len(current.helper_obligations))
+            for retained in current.helper_obligations:
+                if (retained.kind in {"deferred_result_carrier", "class_member_base"}
+                        or current.kind in {"unknown", "implicit_class", "implicit_class_instance"}):
+                    pending.append((role, retained))
+        self.budget.consume(2 + 2 * len(identities))
+        return tuple(dict.fromkeys(identities)), unresolved, _ordered_flow_roots((issues,), self.budget)
+
+    def _class_member_obligations(
+        self, owner: _FlowValue, member_name: str | None,
+        values: Mapping[str, _FlowValue], *, include_inherited: bool = True,
+    ) -> tuple[_FlowValue, ...]:
+        if (not owner.authority_refs and not owner.helper_obligations
+                and owner.kind not in {"implicit_class", "implicit_class_instance",
+                                       "maybe_unbound", "implicit_protocol_merged"}):
+            return ()
+        identities, _unresolved, issues = self._class_member_owner_ids(
+            owner, values, instance_read=True, member_lookup=include_inherited,
+        )
+        self.budget.consume()
+        self.budget.consume(len(issues))
+        roots: list[_FlowValue] = list(issues)
+        store = self._authority(values)
+        for identity in identities:
+            self.budget.consume()
+            record = store.objects.get(identity)
+            if record is None:
+                # A missing retained store cannot prove a clean member result.
+                roots.append(_FlowValue("helper_deferred_refusal",
+                                        reason="helper namespace authority state is unresolved"))
+                continue
+            for name, supplied in record.member_obligations:
+                self.budget.consume(1 + len(supplied))
+                if member_name is None or name == member_name:
+                    roots.extend(supplied)
+            self.budget.consume(len(record.member_wildcard))
+            roots.extend(record.member_wildcard)
+        return _ordered_flow_roots((roots,), self.budget)
+
+    def _with_class_member_authority(
+        self, installed: _FlowValue, class_values: Mapping[str, _FlowValue],
+        frame: _ClassFrame, bases: Sequence[tuple[ast.expr, _FlowValue]],
+        values: Mapping[str, _FlowValue],
+    ) -> _FlowValue:
+        if not isinstance(values, _ExecutionState) or not values.authority.enabled:
+            return installed
