+        if any(type(cell) is _LexicalCellId and cell not in state.cells for cell in cells):
+            return "helper namespace retained lexical cell is unresolved"
+    for name in record.value.namespace_effects & scope.nonlocal_names:
+        cells = bindings.get(name, ())
