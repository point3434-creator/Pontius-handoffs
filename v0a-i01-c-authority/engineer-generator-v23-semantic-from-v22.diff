+def _captured_bindings(
+    value: _FlowValue, state: _ExecutionState,
+) -> dict[str, tuple[_CellIdentity, ...]]:
+    budget = state.authority.budget
+    alternatives: dict[str, tuple[_CellIdentity, ...]] = {}
+    unresolved: set[str] = set()
+    budget.consume(2)
+    for identity in value.authority_refs:
+        record = state.authority.objects.get(identity)
+        budget.consume()
+        if record is None:
+            unresolved.update(value.namespace_effects)
+            continue
+        scope = record.value.callable_scope
+        binding_view = dict(record.cells)
+        budget.consume(1 + len(record.cells))
+        if scope is None and record.value.namespace_effects:
+            unresolved.update(record.value.namespace_effects)
+        if scope is not None:
+            for name in record.value.namespace_effects & scope.nonlocal_names:
+                if not _proved_nonlocal_destination(name, scope, binding_view, state):
+                    unresolved.add(name)
+        for name, cells in record.cells:
