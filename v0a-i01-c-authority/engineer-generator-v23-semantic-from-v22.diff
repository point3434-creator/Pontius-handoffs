+class _CallableCaptureVisitor(ast.NodeVisitor):
+    """Use lexical barriers, including forwarding through nested definitions."""
+
+    def __init__(self, scope: _LexicalBindingScope, budget: _AnalysisBudget,
+                 *, class_body: bool = False) -> None:
+        self.scope = scope
+        self.budget = budget
+        self.class_body = class_body
+        self.loaded: set[str] = set()
+        self.forwarded: set[str] = set()
+        self.hidden: frozenset[str] = frozenset()
+        budget.consume(5)
+
+    def visit(self, node: ast.AST) -> None:
+        self.budget.consume()
+        return super().visit(node)
+
+    def visit_Name(self, node: ast.Name) -> None:
+        if isinstance(node.ctx, ast.Load) and node.id not in self.hidden:
+            self.loaded.add(node.id)
+
+    def _function(self, node: ast.FunctionDef | ast.AsyncFunctionDef | ast.Lambda) -> None:
+        for expression in (*getattr(node, "decorator_list", ()),
+                           *node.args.defaults, *node.args.kw_defaults):
+            if expression is not None:
+                self.visit(expression)
+        child_scope, free = _callable_capture_scope(node, self.budget)
+        forwarded = free - child_scope.global_names - self.hidden
+        if not self.class_body:
+            forwarded -= self.scope.global_names
+        self.budget.consume(len(forwarded))
+        self.forwarded.update(forwarded)
+
+    visit_FunctionDef = _function
+    visit_AsyncFunctionDef = _function
+    visit_Lambda = _function
+
+    def visit_ClassDef(self, node: ast.ClassDef) -> None:
+        for expression in (*node.decorator_list, *node.bases,
+                           *(keyword.value for keyword in node.keywords)):
+            self.visit(expression)
+        _scope, free = _callable_capture_scope(node, self.budget)
+        forwarded = free - self.hidden
+        if not self.class_body:
+            forwarded -= self.scope.global_names
+        self.budget.consume(len(forwarded))
+        self.forwarded.update(forwarded)
+
+    def _comprehension(self, node: ast.ListComp | ast.SetComp |
+                       ast.DictComp | ast.GeneratorExp) -> None:
+        self.visit(node.generators[0].iter)
+        hidden = self.hidden
+        targets = frozenset(name for generator in node.generators
+                            for name in _python_bound_names(generator.target))
+        self.budget.consume(1 + len(targets) + len(node.generators))
+        self.hidden = hidden | targets
+        try:
+            for index, generator in enumerate(node.generators):
+                if index:
+                    self.visit(generator.iter)
+                for condition in generator.ifs:
+                    self.visit(condition)
+            for expression in ((node.key, node.value) if isinstance(node, ast.DictComp)
+                               else (node.elt,)):
+                self.visit(expression)
+        finally:
+            self.hidden = hidden
+
+    visit_ListComp = _comprehension
+    visit_SetComp = _comprehension
+    visit_DictComp = _comprehension
+    visit_GeneratorExp = _comprehension
+
+
+def _callable_capture_scope(
+    definition: ast.FunctionDef | ast.AsyncFunctionDef | ast.Lambda | ast.ClassDef,
+    budget: _AnalysisBudget,
+) -> tuple[_LexicalBindingScope, frozenset[str]]:
+    scope = _lexical_binding_scope(definition, budget)
+    visitor = _CallableCaptureVisitor(scope, budget,
+                                      class_body=isinstance(definition, ast.ClassDef))
+    for statement in ((definition.body,) if isinstance(definition, ast.Lambda)
+                      else definition.body):
+        visitor.visit(statement)
