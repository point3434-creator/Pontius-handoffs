+        meter.charge('publication_layer_count_read')
+        if len(layers) >= _MAXIMUM_NAME_SEALED_LAYERS:
+            layers = _name_compact(meter, layers, cursor._tail)
+            compacted = True
+        else:
+            layer = _name_seal_layer(meter, cursor._tail)
+            meter.charge('publication_layer_tuple_allocation')
+            meter.charge('publication_layer_reference_copies', len(layers) + 1)
+            layers = (*layers, layer)
+    version = _NameVersion(meter, layers, history, cursor._order, cursor._size, cursor._items_cache)
+    meter.charge('publication_fresh_tail_allocation')
+    empty_tail = {}
+    meter.charge('publication_plan_allocation')
+    meter.charge('publication_plan_reference_copies', 4)
+    return _NamePublication(version, empty_tail, True, compacted)
