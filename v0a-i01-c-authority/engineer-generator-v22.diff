+        if plan.compacted:
+            meter.charge('compaction_publication_charge')
+        meter.charge('cursor_publication_reference_copies', 2)
+
+def _name_commit_publication(cursor, plan):
+    if plan.changed:
+        cursor._base = plan.version
+        cursor._tail = plan.empty_tail
