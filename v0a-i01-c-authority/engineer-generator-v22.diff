+_MAXIMUM_NAME_SEALED_LAYERS = 8
+_NAME_MISSING = object()
+_NAME_DELETED = object()
+
+@dataclass(frozen=True, slots=True)
+class _NameEntry:
+    value: object
+    no_work: bool = False
