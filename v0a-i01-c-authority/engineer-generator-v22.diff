+class _NameMeter:
+    """Charge semantic name-storage work through the original analysis budget."""
+    __slots__ = ("budget",)
+
+    def __init__(self, budget):
+        budget.consume(2)  # _NameMeter wrapper plus its retained budget reference.
+        self.budget = budget
+
+    def charge(self, kind, units=1):
+        self.budget.consume(units)
