+@dataclass(frozen=True, slots=True)
+class _AuthorityRecord:
+    """An object in one execution state, never a mutable historical observation."""
+
+    value: _FlowValue
+    cells: tuple[tuple[str, tuple[int, ...]], ...] = ()
+    retained: tuple[_FlowValue, ...] = ()
+
+
+class _AuthorityMap(MutableMapping[Any, Any]):
+    """Copy-on-write table: forks share bytes, the first actual write pays for copying."""
+
+    def __init__(self, budget: _AnalysisBudget) -> None:
+        self.budget = budget
+        self.data: dict[Any, Any] = {}
+        self.shared = False
+
+    def fork(self) -> "_AuthorityMap":
+        self.budget.consume()
+        result = _AuthorityMap(self.budget)
+        self.shared = result.shared = True
+        result.data = self.data
+        return result
+
+    def __getitem__(self, key: Any) -> Any:
+        self.budget.consume()
+        return self.data[key]
+
+    def __setitem__(self, key: Any, value: Any) -> None:
+        self.budget.consume()
+        if key in self.data and self.data[key] == value:
+            return
+        if self.shared:
+            self.budget.consume(len(self.data))
+            self.data = dict(self.data)
+            self.shared = False
+        self.data[key] = value
+
+    def __delitem__(self, key: Any) -> None:
+        if self.shared:
+            self.budget.consume(len(self.data))
+            self.data = dict(self.data)
+            self.shared = False
+        self.budget.consume()
+        del self.data[key]
+
+    def __iter__(self):
+        self.budget.consume(len(self.data))
+        return iter(self.data)
+
+    def __len__(self) -> int:
+        return len(self.data)
+
+    def items(self):
+        self.budget.consume(len(self.data))
+        return self.data.items()
+
+    def values(self):
+        self.budget.consume(len(self.data))
+        return self.data.values()
+
+    def clear(self) -> None:
+        self.budget.consume()
+        self.data = {}
+        self.shared = False
+
+
+class _ObservedAuthorityMap:
+    """Layered observations: published dictionaries stay immutable after a fork."""
+
+    # This is a storage compaction threshold, not an analysis admission cap.
+    _COMPACT_AT_LAYERS = 8
+
+    def __init__(self, budget: _AnalysisBudget) -> None:
+        budget.consume(3)  # Map wrapper, empty dictionary and layer tuple.
+        self.budget = budget
+        self.layers: tuple[dict[int, _FlowValue], ...] = ({},)
+        self.shared = False
+
+    def fork(self) -> "_ObservedAuthorityMap":
+        self.budget.consume()  # New wrapper; the layer tuple is shared unchanged.
+        result = object.__new__(_ObservedAuthorityMap)
+        result.budget = self.budget
+        result.layers = self.layers
+        self.shared = result.shared = True
+        return result
+
+    def get(self, key: int, default: _FlowValue | None = None) -> _FlowValue | None:
+        for layer in reversed(self.layers):
+            self.budget.consume()  # Each attempted dictionary lookup.
+            value = layer.get(key)
+            if value is not None:
+                return value
+        return default
+
+    def __setitem__(self, key: int, value: _FlowValue) -> None:
+        previous = self.get(key)
+        if previous is value or previous == value:
+            return
+        if self.shared:
+            if len(self.layers) >= self._COMPACT_AT_LAYERS:
+                self.budget.consume()  # Fresh compaction dictionary.
+                combined: dict[int, _FlowValue] = {}
+                for layer in self.layers:
+                    self.budget.consume(len(layer) + 1)  # Layer and every visited entry.
+                    combined.update(layer)
+                self.budget.consume()  # Fresh one-layer tuple.
+                self.layers = (combined,)
+            else:
+                # Copy layer references, then allocate the new dictionary and tuple.
+                self.budget.consume(len(self.layers) + 2)
+                self.layers = (*self.layers, {})
+            self.shared = False
+        self.budget.consume()  # The actual write is to this branch's owned last layer.
+        self.layers[-1][key] = value
+
+    def clear(self) -> None:
+        self.budget.consume(2)  # Replacement dictionary and tuple; siblings retain theirs.
+        self.layers = ({},)
+        self.shared = False
+
+
+class _AuthorityState:
+    """Bounded object/cell store. Forks own maps; records and values are immutable."""
+
+    def __init__(self, budget: _AnalysisBudget, enabled: bool = True) -> None:
+        self.budget = budget
+        self.enabled = enabled
+        self.objects = _AuthorityMap(budget)
+        self.cells = _AuthorityMap(budget)
+        self.results = _AuthorityMap(budget)
+        self.observed = _ObservedAuthorityMap(budget)
+
+    def identity(self) -> int:
+        self.budget.consume()
+        self.budget.next_authority_identity += 1
+        return self.budget.next_authority_identity
+
+    def fork(self) -> "_AuthorityState":
+        self.budget.consume()  # Allocate only the state wrapper before actual table forks.
+        result = object.__new__(_AuthorityState)
+        result.budget = self.budget
+        result.enabled = self.enabled
+        if self.enabled:
+            result.objects = self.objects.fork()
+            result.cells = self.cells.fork()
+            result.results = self.results.fork()
+            result.observed = self.observed.fork()
+        else:
+            self.budget.consume(6)  # Three empty ordinary map wrappers and dictionaries.
+            result.objects = _AuthorityMap(self.budget)
+            result.cells = _AuthorityMap(self.budget)
+            result.results = _AuthorityMap(self.budget)
+            result.observed = _ObservedAuthorityMap(self.budget)
+        return result
+
+    def join(self, supplied: "_AuthorityState") -> None:
+        # Shared unchanged tables need no walk. Only actual divergent records
+        # and cells are copied/merged, and that work remains fully metered.
+        if self.objects.data is not supplied.objects.data:
+            self.budget.consume()
+            for identity, record in supplied.objects.items():
+                previous = self.objects.get(identity)
+                if previous is None:
+                    self.objects[identity] = record
+                elif previous != record:
+                    self.objects[identity] = _AuthorityRecord(
+                        _merge_flow_values("authority object", (previous.value, record.value)),
+                        tuple(dict.fromkeys((*previous.cells, *record.cells))),
+                        (*previous.retained, *record.retained),
+                    )
+        if self.cells.data is not supplied.cells.data:
+            self.budget.consume()
+            for identity, value in supplied.cells.items():
+                previous = self.cells.get(identity)
+                if previous != value:
+                    self.cells[identity] = (value if previous is None else
+                                           _merge_flow_values("authority cell", (previous, value)))
+        self.observed.clear()
+        self.results.clear()
+
+
+def _transfer_authority(value: _FlowValue, state: "_ExecutionState",
+                        *, retained: bool = False) -> _FlowValue:
+    """The only registration/forwarding boundary for live helper authority.
+
+    Legacy fields describe captured values. Once registered, mutable retained
+    edges and lexical cells are read only from this successor's identity store.
+    Unknown legacy precision does not erase its authority references.
+    """
+    store = state.authority
+    if not store.enabled:
+        return value
+    store.budget.consume()
+    if value.authority_refs:
+        if all(identity in store.objects for identity in value.authority_refs):
+            return value
+        # A legacy summary/entry boundary may not reconstruct live cells from
+        # a value snapshot. Retain an explicit obligation until consumption.
+        reason = "helper namespace authority state is unresolved"
+        value = replace(value, authority_refs=(), helper_refusal=reason,
+                        helper_obligations=(*value.helper_obligations, _FlowValue(
+                            "helper_deferred_refusal", reason=reason)))
+    updates: dict[str, object] = {}
+    if value.kind in {"sequence", "slice", "maybe_unbound"}:
+        updates["value"] = tuple(_transfer_authority(item, state, retained=True)
+                                 if isinstance(item, _FlowValue) else item
+                                 for item in value.value)
+    elif value.kind in {"mapping", "mapping_keys"}:
+        updates["value"] = tuple(tuple(_transfer_authority(item, state, retained=True)
+                                       if isinstance(item, _FlowValue) else item
+                                       for item in pair) for pair in value.value)
+    elif value.kind == "starred_argument" and isinstance(value.value, _FlowValue):
+        updates["value"] = _transfer_authority(value.value, state, retained=True)
+    if value.callable_defaults:
+        updates["callable_defaults"] = tuple((name, _transfer_authority(item, state, retained=True))
+                                            for name, item in value.callable_defaults)
+    if value.helper_receiver is not None:
+        updates["helper_receiver"] = _transfer_authority(value.helper_receiver, state, retained=True)
+    if value.helper_obligations:
+        updates["helper_obligations"] = tuple(_transfer_authority(item, state, retained=True)
+                                              for item in value.helper_obligations)
+    value = replace(value, **updates) if updates else value
+    if (value.mutable_collection or retained and value.helper_provenance is not None
+            or value.callable_definition is not None or value.helper_obligations
+            or value.helper_receiver is not None or value.callable_defaults
+            or value.namespace_effects or value.helper_refusal is not None
+            or value.kind in {"sequence", "mapping", "mapping_keys", "slice"}):
+        identity = store.identity()
+        store.objects[identity] = _AuthorityRecord(replace(value, authority_refs=()))
+        value = replace(value, authority_refs=(identity,))
+    return value
+
+
+class _ExecutionState(dict[str, _FlowValue]):
+    """Name values plus explicit branch-owned authority and activation cells.
+
+    Every mutating dict API used by the resolver is explicit here: builtin dict
+    update/setdefault do not dispatch through an overridden __setitem__.
+    """
+
+    def __init__(self, values: Mapping[str, _FlowValue], budget: _AnalysisBudget,
+                 *, parent: Mapping[str, _FlowValue] | None = None,
+                 local_names: Iterable[str] = (), enabled: bool = True) -> None:
+        dict.__init__(self)
+        self.authority = (parent.authority.fork() if isinstance(parent, _ExecutionState)
+                          else _AuthorityState(budget, enabled))
+        self.bindings = (parent.bindings.fork() if isinstance(parent, _ExecutionState)
+                         else _AuthorityMap(budget))
+        for name in local_names if self.authority.enabled else ():
+            self.bindings[name] = (self.authority.identity(),)
+        for name, value in values.items():
+            if (isinstance(parent, _ExecutionState) and name not in local_names
+                    and parent.get(name) is value):
+                # Exact inherited values keep their parent's already-forked authority.
+                self.authority.budget.consume()  # Copy this name without another transfer.
+                dict.__setitem__(self, name, value)
+            else:
+                self[name] = value
+
+    def cell(self, name: str) -> tuple[int, ...]:
+        if name not in self.bindings:
+            identity = self.authority.identity()
+            self.bindings[name] = (identity,)
+            self.authority.cells[identity] = self.get(
+                name, _flow_unknown("captured global binding is dynamically unresolved"))
+        return self.bindings[name]
+
+    def __setitem__(self, name: str, value: _FlowValue) -> None:
+        value = _transfer_authority(value, self)
+        dict.__setitem__(self, name, value)
+        # Uncaptured module globals retain immutable provenance in the value
+        # map. A cell is allocated only by actual lexical capture; locals were
+        # allocated for this activation at entry, including not-yet-bound ones.
+        if self.authority.enabled:
+            identities = self.bindings.get(name, ())
+            for identity in identities:
+                self.authority.cells[identity] = (value if len(identities) == 1 else
+                    _merge_flow_values("alternative cell write", (
+                        self.authority.cells.get(identity), value)))
+
+    def __delitem__(self, name: str) -> None:
+        dict.__delitem__(self, name)
+        if self.authority.enabled:
+            identities = self.bindings.get(name, ())
+            for identity in identities:
+                deleted = _FlowValue("unbound", reason="deleted cell")
+                self.authority.cells[identity] = (deleted if len(identities) == 1 else
+                    _merge_flow_values("alternative cell delete", (
+                        self.authority.cells.get(identity), deleted)))
+
+    def pop(self, name: str, default: object = None) -> object:
+        if name not in self:
+            return default
+        value = self[name]
+        del self[name]
+        return value
+
+    def setdefault(self, name: str, default: _FlowValue) -> _FlowValue:
+        if name not in self:
+            self[name] = default
+        return self[name]
+
+    def update(self, supplied: object = (), **keywords: _FlowValue) -> None:
+        if isinstance(supplied, _ExecutionState):
+            self.authority = supplied.authority.fork()
+            self.bindings = supplied.bindings.fork()
+            dict.update(self, supplied)
+            for name, value in keywords.items():
+                self[name] = value
+            return
+        items = supplied.items() if isinstance(supplied, Mapping) else supplied
+        for name, value in items:
+            self[name] = value
+        for name, value in keywords.items():
+            self[name] = value
+
+    def clear(self) -> None:
+        # A replacement/terminated name map is not a sequence of Python deletes.
+        dict.clear(self)
+
+    def copy(self) -> "_ExecutionState":
+        result = dict.__new__(_ExecutionState)
+        dict.__init__(result, self)
+        result.authority = self.authority.fork()
+        result.bindings = self.bindings.fork()
+        return result
+
