+            elif name == "_c_eval" and span["site"]["kind"] in ("Compare", "GeneratorExp"):
+                self.emit("evaluation_exit", span, outcomes=self.outcomes(result))
+            elif name == "_c_statement" and span["site"]["kind"] in ("If", "Try", "Raise"):
