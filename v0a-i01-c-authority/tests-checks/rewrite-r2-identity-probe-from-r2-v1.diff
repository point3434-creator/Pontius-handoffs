+                    "entries": span["entries"], "attempts": 0, "completed": 0,
+                    "attempted_entries": 0, "completed_entries": 0})
+                copy["attempts"] += 1
+                copy["attempted_entries"] += span["entries"]
+                if failure is None:
+                    copy["completed"] += 1
