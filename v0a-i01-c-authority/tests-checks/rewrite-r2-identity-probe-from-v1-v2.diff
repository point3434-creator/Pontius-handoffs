+class ObserverLifecycle:
+    """Own all observer acquisition and teardown; never replace a body exception."""
+    def __init__(self, module, identifier, source_sha):
+        self.module, self.identifier, self.source_sha = module, identifier, source_sha
+        # Capture rollback identities before any observer can mutate the module.
+        self.budget_class = module._AnalysisBudget
+        self.budget_originals = {name: getattr(self.budget_class, name)
+                                 for name in ("__init__", "consume")}
+        self.hook_originals = {name: vars(module)[name] for name in MechanismObserver.HOOKS}
+        self.original_codes = {name: value.__code__ for name, value in
+                               (*self.budget_originals.items(), *self.hook_originals.items())}
+        self.budget, self.mechanism = None, None
+        self.metrics, self.mechanism_metrics = None, None
+        self.events, self.errors = [], []
+        self.acquired, self.closed = False, False
+        self.acquisition_stage = "not-started"
+        self.budget_restored, self.mechanism_restored = False, False
+
+    def record_error(self, stage, error):
+        try:
+            message = str(error)
+        except BaseException:
+            message = "<diagnostic string unavailable>"
+        self.errors.append({"stage": stage, "type": type(error).__name__, "message": message})
+
+    def attempt(self, stage, action):
+        try:
+            result = action()
+        except BaseException as error:
+            self.record_error(stage, error)
+            self.events.append({"stage": stage, "completed": False})
+            return None
+        self.events.append({"stage": stage, "completed": True})
+        return result
+
+    def __enter__(self):
+        try:
+            self.acquisition_stage = "budget.construct"
+            self.budget = BudgetObserver(self.module)
+            self.events.append({"stage": "budget.construct", "completed": True})
+            self.acquisition_stage = "budget.install"
+            self.budget.install()
+            self.events.append({"stage": "budget.install", "completed": True})
+            self.acquisition_stage = "budget.begin"
+            self.budget.begin(self.identifier)
+            self.events.append({"stage": "budget.begin", "completed": True})
+            self.acquisition_stage = "mechanism.construct"
+            self.mechanism = MechanismObserver(self.module, self.budget, self.source_sha)
+            self.events.append({"stage": "mechanism.construct", "completed": True})
+            self.acquisition_stage = "mechanism.install"
+            self.mechanism.install()
+            self.events.append({"stage": "mechanism.install", "completed": True})
+            self.acquired = True
+            self.acquisition_stage = "complete"
+            return self
+        except BaseException as primary:
+            # Partial installation, begin and constructor failures all enter rollback.
+            try:
+                self.close()
+            except BaseException:
+                # close has independent finalizers; preserve the acquisition exception.
+                pass
+            try:
+                primary.add_note("observer acquisition failed; cleanup: "
+                                 + json.dumps(self.report(), allow_nan=False))
+            except BaseException:
+                pass
+            raise
+
+    def close(self):
+        if self.closed:
+            return
+        self.closed = True
+        try:
+            if self.mechanism is not None:
+                restored = self.attempt("mechanism.restore", self.mechanism.restore)
+                if restored is not True:
+                    self.record_error("mechanism.restore-result",
+                                      RuntimeError("mechanism restoration not reported intact"))
+                self.mechanism_metrics = self.attempt("mechanism.result", self.mechanism.result)
+            if self.budget is not None:
+                if self.budget.current is not None:
+                    self.metrics = self.attempt("budget.end", self.budget.end)
+                restored = self.attempt("budget.restore", self.budget.restore)
+                if restored is not True:
+                    self.record_error("budget.restore-result",
+                                      RuntimeError("budget restoration not reported intact"))
+        finally:
+            # These writes do not depend on either observer's end/result/restore succeeding.
+            # Each restoration is independently attempted, including a partial install.
+            try:
+                for name, original in self.hook_originals.items():
+                    self.attempt("force-hook:" + name,
+                                 lambda name=name, original=original:
+                                 setattr(self.module, name, original))
+            finally:
+                for name, original in self.budget_originals.items():
+                    self.attempt("force-budget:" + name,
+                                 lambda name=name, original=original:
+                                 setattr(self.budget_class, name, original))
+                self.mechanism_restored = self.attempt("verify-mechanism", lambda: all(
+                    vars(self.module).get(name) is original
+                    and original.__code__ is self.original_codes[name]
+                    for name, original in self.hook_originals.items())) is True
+                self.budget_restored = self.attempt("verify-budget", lambda: all(
+                    getattr(self.budget_class, name) is original
+                    and original.__code__ is self.original_codes[name]
+                    for name, original in self.budget_originals.items())) is True
+
+    def __exit__(self, kind, primary, traceback):
+        try:
+            self.close()
+        except BaseException as cleanup_error:
+            # No cleanup/projection diagnostic may replace a propagated body exception.
+            try:
+                self.record_error("lifecycle.close", cleanup_error)
+            except BaseException:
+                pass
+        if primary is not None and self.errors:
+            try:
+                primary.add_note("observer teardown diagnostics: "
+                                 + json.dumps(self.report(), allow_nan=False))
+            except BaseException:
+                pass
+        return False
+
+    def report(self):
+        return {"schema": "pontius-r2-observer-lifecycle-v1",
+                "acquired": self.acquired, "closed": self.closed,
+                "acquisition_stage": self.acquisition_stage,
+                "budget_methods_restored": self.budget_restored,
+                "mechanism_methods_restored": self.mechanism_restored,
+                "events": self.events, "errors": self.errors,
+                "complete": self.acquired and self.closed and self.budget_restored
+                            and self.mechanism_restored and not self.errors
+                            and self.metrics is not None and self.mechanism_metrics is not None}
+
+
+def validate_lifecycle(record):
+    require(type(record) is dict and record["schema"] == "pontius-r2-observer-lifecycle-v1",
+            "observer lifecycle schema")
+    for key in ("acquired", "closed", "budget_methods_restored",
+                "mechanism_methods_restored", "complete"):
+        require(type(record[key]) is bool, "lifecycle exact Boolean: " + key)
+    require(type(record["events"]) is list and type(record["errors"]) is list
+            and type(record["acquisition_stage"]) is str, "lifecycle scalar containers")
+    for event in record["events"]:
+        require(type(event) is dict and set(event) == {"stage", "completed"}
+                and type(event["stage"]) is str and type(event["completed"]) is bool,
+                "lifecycle event")
+    for error in record["errors"]:
+        require(type(error) is dict and set(error) == {"stage", "type", "message"}
+                and all(type(value) is str for value in error.values()), "lifecycle error")
+    normal_stages = ["budget.construct", "budget.install", "budget.begin",
+                     "mechanism.construct", "mechanism.install", "mechanism.restore",
+                     "mechanism.result", "budget.end", "budget.restore"]
+    normal_stages.extend("force-hook:" + name for name in BASELINE_HOOKS)
+    normal_stages.extend(("force-budget:__init__", "force-budget:consume",
+                          "verify-mechanism", "verify-budget"))
+    structurally_complete = (
+        record["acquired"] and record["closed"] and record["acquisition_stage"] == "complete"
+        and record["budget_methods_restored"] and record["mechanism_methods_restored"]
+        and not record["errors"] and record["events"] ==
+        [{"stage": stage, "completed": True} for stage in normal_stages])
+    require(record["complete"] is structurally_complete, "lifecycle completion replay")
+    return structurally_complete
 
 
