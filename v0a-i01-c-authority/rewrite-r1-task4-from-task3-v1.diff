+def _c_construct_class(
+    ctx: _CContext, state: _CState, frame: _CFrame, node: ast.ClassDef,
+) -> tuple[_COutcome, ...]:
+    if node.decorator_list or node.keywords or getattr(node, "type_params", ()):
+        return _c_one(ctx, _c_fail(ctx, state, node, "unsupported class construction header"))
+    ctx.budget.consume()
+    outcomes: list[_COutcome] = []
+    for prior, bases in _c_eval_many(ctx, state, frame, node.bases):
+        ctx.budget.consume()
+        if prior.control != "normal":
+            ctx.budget.consume(2)
+            outcomes.append(prior)
+            continue
+        origin = "local"
+        if bases:
+            if len(bases) != 1 or type(bases[0]) is not _CAtom or (
+                    bases[0].kind != "symbol" or bases[0].data != "unittest.TestCase"):
+                ctx.budget.consume(2)
+                outcomes.append(_c_follow(ctx, prior, _c_fail(
+                    ctx, prior.state, node, "unsupported class inheritance")))
+                continue
+            origin = "unittest.TestCase"
+        ctx.budget.consume(7)  # Empty map/proxy and namespace record.
+        owner = _c_new_object(ctx, prior.state, _CNamespace(
+            "class", MappingProxyType({}), origin))
+        ctx.budget.consume()
+        scope = ctx.program.scopes[node]
+        captures = _c_captures(ctx, prior.state, frame, scope)
+        enclosing = frame.enclosing_nonclass if frame.scope.kind == "class" else frame
+        ctx.budget.consume(7)
+        local = _CFrame(scope, None, captures, frame.module, owner, enclosing)
+        for body in _c_statements(ctx, _c_out(ctx, prior.state), local, node.body):
+            ctx.budget.consume()
+            completed = _c_follow(ctx, prior, body)
+            produced = _c_store_name(ctx, body.state, frame, node.name, owner, node) if (
+                body.control == "normal") else _c_one(ctx, body)
+            for result in produced:
+                ctx.budget.consume(2)
+                outcomes.append(_c_follow(ctx, completed, result) if (
+                    body.control == "normal") else completed)
+    return _c_join(ctx, outcomes)
