+    offset = len(positional) - len(parameters.defaults)
+    for index, default in enumerate(parameters.defaults):
+        ctx.budget.consume(5)
+        expressions.append(default)
+        default_names.append(positional[offset + index].arg)
+    for parameter, default in zip(parameters.kwonlyargs, parameters.kw_defaults, strict=True):
+        ctx.budget.consume()
+        if default is not None:
+            ctx.budget.consume(4)
+            expressions.append(default)
+            default_names.append(parameter.arg)
+    ctx.budget.consume()
+    outcomes: list[_COutcome] = []
+    for prior, values in _c_eval_many(ctx, state, frame, expressions):
+        ctx.budget.consume()
+        if prior.control != "normal":
+            ctx.budget.consume(2)
+            outcomes.append(prior)
+            continue
