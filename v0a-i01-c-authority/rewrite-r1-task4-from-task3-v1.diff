+def _c_construct_function(
+    ctx: _CContext, state: _CState, frame: _CFrame,
+    node: ast.FunctionDef | ast.AsyncFunctionDef,
+) -> tuple[_COutcome, ...]:
+    ctx.budget.consume(2)
+    scope = ctx.program.scopes[node]
