+def _c_extend_review_rows(
+    ctx: _CContext, target: list[dict[str, object]], source: list[dict[str, object]],
+) -> None:
+    ctx.budget.consume(2 * len(source))  # Copied element visits and installed references.
+    target.extend(source)
+
