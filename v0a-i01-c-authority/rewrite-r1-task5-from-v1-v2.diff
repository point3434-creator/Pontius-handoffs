+def _c_preflight_blocker(
+    ctx: _CContext, target: list[dict[str, object]], node: ast.AST, reason: str,
+) -> None:
+    ctx.budget.consume(11)  # Four-field dictionary plus append operation/reference.
+    target.append(_review_blocker(ctx.item_id, ctx.path, node, reason))
+
+
+def _c_entry_namespace_supported(ctx: _CContext, namespace: _CNamespace) -> bool:
+    for name in namespace.members:
+        ctx.budget.consume(2)  # Name visit and prefix check.
+        dunder = name.startswith("__")
+        if dunder:
+            ctx.budget.consume()
+            dunder = name.endswith("__")
+        if dunder:
+            return False
+        ctx.budget.consume()  # Reached reserved-name membership probe.
+        if name in _C_UNITTEST_RESERVED_NAMES:
+            return False
+    return True
