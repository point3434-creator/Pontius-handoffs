+    old, current = s.inventory(BASE), s.inventory(s.commit)
+    require(set(current) == set(old) | set(NEW)
+            and all(current[p] == oid for p, oid in old.items()))
+    batch = s.command('cat-file', '--batch', content=('\n'.join(current.values())+'\n').encode())
