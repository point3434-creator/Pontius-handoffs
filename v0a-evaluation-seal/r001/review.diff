+        self.source = self.r.admit_source(ROOT)
+        self.base = Path(tempfile.mkdtemp(prefix='ev-boundary-'))
+        self.fixture = json.loads((ROOT / 'tests/fixtures/evaluation/controls.json').read_bytes())
+
+    def publication(self):
